<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.2/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Sms">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">API</directory>
            <directory suffix=".php">Application</directory>
            <directory suffix=".php">Domain</directory>
            <directory suffix=".php">Infrastructure</directory>
        </include>
    </source>
    <groups>
        <exclude>
            <!--
                `network` sends a REAL message and is billed. It is excluded by
                default so that a plain `phpunit` run cannot spend money; opt in
                with the group flag when you mean to.
            -->
            <group>network</group>
        </exclude>
    </groups>
</phpunit>
